# Local development overrides (Do NOT commit to source control)
# In production, secrets are securely retrieved from GCP Secret Manager.

PORT=3001
GCP_PROJECT_ID=your-gcp-project-id
CORS_ORIGIN=http://localhost:5173

# Local dev ONLY - Un-comment and set to bypass Secret Manager
# GEMINI_API_KEY=your-gemini-api-key

# Local dev ONLY - Un-comment and point to service account key file for ADC
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
